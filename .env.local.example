# Design Ref: §8.3 환경변수 — 로컬은 Neon dev 브랜치, Vercel prod는 main 브랜치를 가리킨다
DATABASE_URL=postgresql://user:password@ep-xxxx-dev.neon.tech/pdca_workspace?sslmode=require

# Decision: [Do] Neon Auth 실제 제공자는 better_auth (Plan RK-03 실증, Stack Auth 가정 파기).
# `neonctl neon-auth status --project-id <id> --branch <dev|production>` 로 조회.
# 브랜치별로 값이 다르다 — dev/prod 각 환경에 맞는 값을 넣을 것.
NEON_AUTH_JWKS_URL=https://ep-xxxx.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.<region>.aws.neon.tech/neondb/auth
VITE_NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.<region>.aws.neon.tech/neondb/auth
